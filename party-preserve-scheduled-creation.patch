+                    db = Storage(Path(tmp) / 'test.sqlite3')
+                    opening = opening_for_week(START, raid_type)
+                    deleted_at = opening + timedelta(seconds=offset)
+                    db.insert('100', START, '101', None, EMOJIS, raid_type)
